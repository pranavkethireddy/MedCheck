# Copy this file to .env and fill in your real values.
# .env is already in .gitignore so your keys won't get committed.

# Supabase project: Project Settings -> API. Use the SECRET/service_role
# key here (never the anon/publishable key) — this backend needs to bypass
# Row Level Security to write on behalf of any user.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-sb_secret-key

# Locks down CORS to your frontend's origin. "*" works for local dev.
CORS_ORIGIN=*

# Backend Person 2's Gemini rewrite step (app/gemini_client.py). Get a key
# at https://aistudio.google.com/apikey. If this is missing or invalid,
# /api/check-interactions still works — each interaction's "explanation"
# field just silently falls back to the raw curated/openFDA description
# instead of Gemini's plain-English rewrite (see _safe_explain). Used for
# interaction explanations + the risk summary only (the "default" pool) —
# NOT the voice assistant, see GEMINI_VOICE_API_KEY below.
GEMINI_API_KEY=your-gemini-api-key

# A SEPARATE Gemini key, used ONLY by the caregiver voice assistant (app/
# voice_assistant.py — the "voice" pool in gemini_client.py). Google's free
# tier rate-limits per key (~10 requests/minute), not per app, so sharing
# one key across everything means interaction checks and voice commands
# compete for the same budget. Get this from a DIFFERENT Google account
# than whoever made GEMINI_API_KEY above (two people, two free quotas) at
# https://aistudio.google.com/apikey. If this is missing, voice quietly
# falls back to sharing GEMINI_API_KEY instead — not broken, just not
# quota-isolated until this is set.
GEMINI_VOICE_API_KEY=your-second-gemini-api-key

# Optional per-pool model override. Both keys default to
# GEMINI_MODEL in gemini_client.py ("gemini-flash-latest" — Google's own
# alias for their current recommended flash-tier model, chosen deliberately
# over a specific dated model like "gemini-2.5-flash": we hit that exact
# model 404 live on a newly-created key with Gemini's own error saying
# "This model models/gemini-2.5-flash is no longer available to new
# users" — it still showed up in ListModels, it just couldn't actually be
# called anymore by a fresh key. If a key ever hits that again (a dated
# model gets cut off for new users, or a specific account genuinely lacks
# a model), Gemini's error message names the replacement — set this to
# that instead of debugging further. (GEMINI_MODEL works the same way for
# the default/GEMINI_API_KEY pool, if that one ever needs overriding too.)
# GEMINI_VOICE_MODEL=gemini-flash-latest

# Backboard persistent-memory integration (app/backboard_client.py) — "Best
# Use of Backboard" prize track. Get a key from the Backboard dashboard:
# https://app.backboard.io -> Settings -> API Keys. If this is missing or
# invalid, /api/memory/* just no-ops (empty list / skipped save) rather
# than erroring, and save-medication / check-interactions are unaffected.
BACKBOARD_API_KEY=your-backboard-api-key

# ElevenLabs voice integration (app/elevenlabs_client.py) — "Best Use of
# ElevenLabs" prize track. Get a key at https://elevenlabs.io -> Profile ->
# API Keys. Unlike Gemini/Backboard above, /api/voice/* endpoints return a
# real error (502) if this is missing or invalid, since voice IS the
# feature being requested there — but nothing else in the app depends on
# it, so the rest of MedCheck works fine either way.
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Optional: a specific ElevenLabs voice id. Defaults to "Rachel"
# (21m00Tcm4TlvDq8ikWAM), a calm preset voice, if not set.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
